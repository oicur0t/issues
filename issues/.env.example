# MongoDB Atlas Configuration
# For regular connection:
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/issue-tracker?retryWrites=true&w=majority

# For X.509 Certificate Authentication (MongoDB Atlas):
# MONGODB_URI=mongodb+srv://cluster0.rrp7vpi.mongodb.net/issues?authSource=%24external&authMechanism=MONGODB-X509&retryWrites=true&w=majority&appName=Cluster0
# MONGODB_CERT_PATH=./Certs/X509-cert-5964230336800025568.pem

# Application Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here

# Mock Authentication (for development)
MOCK_USER_EMAIL=admin@example.com
MOCK_USER_NAME=Admin User
MOCK_USER_ROLE=admin

# Optional: Node Environment
NODE_ENV=development
# Tailscale host discovery (optional). Create an OAuth client in the Tailscale admin console
# (Settings > Trust credentials) with ONLY the read-only scope devices:core:read.
# TAILSCALE_OAUTH_CLIENT_ID=
# TAILSCALE_OAUTH_CLIENT_SECRET=
# Minutes between automatic syncs (default 60, 0 disables the schedule; "Sync now" still works)
# TAILSCALE_SYNC_INTERVAL_MINUTES=60
# Warn when a node key expires within this many days (default 14)
# TAILSCALE_KEY_EXPIRY_WARN_DAYS=14
# Warn when a device has been offline longer than this many hours (default 24)
# TAILSCALE_OFFLINE_HOURS=24
